{
  "name": "hazy-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3200",
    "build": "vite build",
    "start": "vite preview --port 3200",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check-types": "tsc --noEmit",
    "test": "bun test src/",
    "cf:build": "vite build",
    "cf:deploy": "vite build && wrangler deploy",
    "cf:preview": "vite build && wrangler dev"
  },
  "dependencies": {
    "@repo/api-client": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.46",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@tailwindcss/vite": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6.3.2",
    "wrangler": "^4.123.0"
  }
}
