{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hazy-dash",
  "compatibility_date": "2026-08-14",
  // VITE_* are inlined at build time by Vite; the defaults in src/lib/env.ts
  // already point at production, and there are no secrets (the dash holds no
  // keys — it gets an hz_ token per browser through "Connect with Hazy").
  "routes": [{ "pattern": "dash.hz.nknighta.me", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
