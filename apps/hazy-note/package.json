{
  "name": "hazy-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "start": "vite preview --port 3000",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check-types": "tsc --noEmit",
    "test": "bun test lib/",
    "test:e2e": "playwright test",
    "db:sync-from-neon": "bash scripts/sync-from-neon.sh",
    "cf:build": "vite build",
    "cf:deploy": "vite build && wrangler deploy",
    "cf:preview": "vite build && wrangler dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@phosphor-icons/web": "^2.1.1",
    "@repo/api-client": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.46",
    "@ternlight/base": "^0.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "quill": "^2.0.3",
    "quilljs-markdown": "^1.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22.10.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4",
    "typescript": "^5.7.3",
    "vite": "^6.3.2",
    "wrangler": "^4.123.0"
  }
}
