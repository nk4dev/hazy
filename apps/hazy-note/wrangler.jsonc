{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hazy-note",
  "compatibility_date": "2026-08-14",
  "routes": [{ "pattern": "note.hz.nknighta.me", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "VITE_API_URL": "https://api.hz.nknighta.me",
    "VITE_HAZY_URL": "https://hz.nknighta.me"
  }
}
