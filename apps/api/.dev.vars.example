# apps/api local config. Copy to `.dev.vars` (gitignored). Used by both
# `bun run dev` (tsx --env-file) and `wrangler dev`.

# --- Database ---
# Local dev (tsx / @hono/node-server, real Node): the hazy-note dev DB over
# postgres.js TCP. See apps/hazy-note/scripts/localdb.sh.
DATABASE_URL=postgresql://hazy@127.0.0.1:5433/hazy
# For `wrangler dev` (workerd) point this at a Neon branch instead — workerd has
# no raw TCP, so it exercises the same neon-http driver production uses.

# --- Clerk (same instance as the web apps) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From the Clerk dashboard Webhooks page, endpoint https://api.hz.nknighta.me/v1/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=

# --- CORS ---
# Comma-separated. localhost:3100 (hazy dev) is always allowed implicitly.
CORS_ALLOWED_ORIGINS=http://localhost:3100
NEXT_PUBLIC_APP_URL=http://localhost:3100

# --- OpenRouter (optional — falls back to canned text when unset) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=meta-llama/llama-3.3-70b-instruct:free
# Comma-separated fallback models tried sequentially if the primary fails
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-r1:free,google/gemini-2.0-flash-exp:free,mistralai/mistral-small-24b-instruct-2501:free
OPENROUTER_SITE_URL=http://localhost:3100
OPENROUTER_APP_NAME=Hazy
