NEXT_PUBLIC_APP_URL=http://localhost:3000
# hazy-note app (separate deploy, same DB) — "Open in Note" deep link on the item page
NEXT_PUBLIC_HAZY_NOTE_URL=http://localhost:3000

# Any Postgres works — Neon, Supabase, RDS, a local Docker/Postgres.app
# instance, etc. (Neon's free tier is the easiest zero-cost start: create a
# project at https://neon.tech, "Connect" button, copy the connection
# string.) A managed provider's string usually already has ?sslmode=require;
# a local Postgres needs no sslmode at all — both are handled automatically.
DATABASE_URL=

# Clerk — https://clerk.com (free Hobby tier). Create an app, copy the keys
# from the API Keys page. CLERK_WEBHOOK_SIGNING_SECRET comes from the
# Webhooks page after you add an endpoint pointing at /api/v1/webhooks/clerk
# (needs a public URL in dev — e.g. `ngrok http 3000`).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# OpenRouter — https://openrouter.ai (free tier, no card required for
# :free-suffixed models). The free-model lineup rotates; check
# https://openrouter.ai/models?max_price=0 for what's currently live.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=google/gemma-4-26b-a4b-it:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Hazy
