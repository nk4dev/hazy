{
  "name": "hazy-repo",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:trigger": "turbo run db:trigger",
    "db:studio": "turbo run db:studio",
    "db:sync-from-neon": "bash apps/hazy-note/scripts/sync-from-neon.sh",
    "cf:build": "turbo run cf:build",
    "cf:deploy": "turbo run cf:deploy",
    "cf:preview": "turbo run cf:preview",
    "deploy": "turbo run deploy",
    "preview": "turbo run preview"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.31",
    "@playwright/test": "^1.62.1",
    "agent-browser": "^0.35.1",
    "turbo": "^2"
  },
  "trustedDependencies": [
    "agent-browser"
  ]
}
