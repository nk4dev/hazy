# Monorepo root environment variables. Copy to `.env.local` (or `.env`).
# Loaded automatically by `api`, `hazy`, `hazy-note`, `hazy-dash`, `packages/db`,
# and Playwright e2e. Per-app `.env.local` / `.dev.vars` files still work as overrides.

# --- Database (api, hazy-note, packages/db) ---
DATABASE_URL=postgresql://hazy@127.0.0.1:5433/hazy

# --- Better Auth (api + subdomains, single-user ADMIN_EMAIL allowlist) ---
BETTER_AUTH_URL=http://localhost:8787
# Set in production to `.hz.nknighta.me` for cross-subdomain session sharing:
BETTER_AUTH_COOKIE_DOMAIN=
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
# GitHub OAuth (enabled when both are set):
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Clerk (legacy fallback during transition / Flutter compatibility) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From the Clerk dashboard Webhooks page, endpoint https://api.hz.nknighta.me/v1/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=
# hazy-note Clerk routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/notes
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/notes

# --- Local URLs & CORS ---
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_HAZY_NOTE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3100
# hazy-dash defaults to production (https://hz.nknighta.me); uncomment for local hazy:
# NEXT_PUBLIC_HAZY_URL=http://localhost:3100

# --- OpenRouter (optional — falls back to canned text when unset) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,openrouter/free
OPENROUTER_NOTE_MODEL_ID=mistralai/mistral-small-2603
OPENROUTER_NOTE_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,openrouter/free
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_SITE_URL=http://localhost:3100
OPENROUTER_APP_NAME=Hazy
